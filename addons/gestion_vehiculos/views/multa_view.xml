<odoo>

    <record id="view_gestion_multa_form" model="ir.ui.view">
        <field name="name">gestion.multa.form</field>
        <field name="model">gestion.multa</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(gestion_vehiculos.action_report_multa)d" string="Imprimir Multa" type="action" class="oe_highlight" icon="fa-print"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Ej: Exceso de velocidad..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Información Económica">
                            <field name="importe"/>
                            <field name="pagada_por_empresa" widget="boolean_toggle"/>
                            <field name="fecha"/>
                        </group>
                        <group string="Asignación">
                            <field name="empleado_id" widget="many2one_avatar_user"/>
                            <field name="vehiculo_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="descripcion" placeholder="Detalles adicionales..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gestion_multa_tree" model="ir.ui.view">
        <field name="name">gestion.multa.list</field>
        <field name="model">gestion.multa</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'pendiente'" decoration-success="state == 'pagada'" decoration-danger="state == 'recurrida'">
                <field name="fecha"/>
                <field name="name"/>
                <field name="empleado_id"/>
                <field name="vehiculo_id"/>
                <field name="importe" sum="Total"/>
                <field name="pagada_por_empresa" widget="boolean_toggle"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Vista Kanban para Multa -->
    <record id="view_gestion_multa_kanban" model="ir.ui.view">
        <field name="name">gestion.multa.kanban</field>
        <field name="model">gestion.multa</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="id"/>
                <field name="name"/>
                <field name="empleado_id"/>
                <field name="importe"/>
                <field name="fecha"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <field name="empleado_id"/>
                                </div>
                                <div>
                                    <span>Importe: </span><field name="importe"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="fecha"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Calendar para Multa -->
    <record id="view_gestion_multa_calendar" model="ir.ui.view">
        <field name="name">gestion.multa.calendar</field>
        <field name="model">gestion.multa</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de Multas" date_start="fecha" color="state" mode="month">
                <field name="name"/>
                <field name="empleado_id"/>
                <field name="pagada_por_empresa"/>
            </calendar>
        </field>
    </record>

    <!-- Vista de búsqueda para Multa -->
    <record id="view_gestion_multa_search" model="ir.ui.view">
        <field name="name">gestion.multa.search</field>
        <field name="model">gestion.multa</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="empleado_id"/>
                <field name="vehiculo_id"/>
                <field name="fecha"/>
                <separator/>
                <filter string="Pendientes" name="pendiente" domain="[('state', '=', 'pendiente')]"/>
                <filter string="Pagadas" name="pagada" domain="[('state', '=', 'pagada')]"/>
                <separator/>
                <filter string="Fecha" name="filter_fecha" date="fecha"/>
                <filter string="Empleado" name="group_by_empleado" context="{'group_by': 'empleado_id'}"/>
                <filter string="Vehículo" name="group_by_vehiculo" context="{'group_by': 'vehiculo_id'}"/>
                <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                <filter string="Pagada por Empresa" name="group_by_pagada_empresa" context="{'group_by': 'pagada_por_empresa'}"/>
            </search>
        </field>
    </record>
    
    <!-- Acción para Multas -->
    <record id="action_gestion_multa" model="ir.actions.act_window">
        <field name="name">Multas</field>
        <field name="res_model">gestion.multa</field>
        <field name="view_mode">list,form,kanban,calendar</field>
        <field name="search_view_id" ref="view_gestion_multa_search"/>
    </record>
</odoo>