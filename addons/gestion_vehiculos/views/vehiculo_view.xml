<odoo>
    <!-- Vista de formulario para Vehículo -->
    <record id="view_gestion_vehiculo_form" model="ir.ui.view">
        <field name="name">gestion.vehiculo.form</field>
        <field name="model">gestion.vehiculo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="De Baja" bg_color="bg-danger" invisible="active"/>
                    
                    <div class="oe_title">
                        <label for="matricula"/>
                        <h1><field name="matricula"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="marca_id"/>
                            <field name="modelo"/>
                            <field name="active" widget="boolean_toggle"/> </group>
                        <group>
                            <field name="kilometros"/>
                            <field name="conductor_id" placeholder="Sin empleado asignado..."/>
                            <field name="estado" widget="badge" 
                                   decoration-success="estado == 'disponible'" 
                                   decoration-info="estado == 'asignado'" 
                                   decoration-muted="estado == 'baja'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historial de Uso">
                            <field name="historial_ids" readonly="1">
                                <list>
                                    <field name="conductor_id"/>
                                    <field name="fecha_inicio"/>
                                    <field name="fecha_fin"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gestion_vehiculo_tree" model="ir.ui.view">
        <field name="name">gestion.vehiculo.tree</field>
        <field name="model">gestion.vehiculo</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="matricula"/>
                <field name="marca_id"/>
                <field name="modelo"/>
                <field name="conductor_id"/>
                <field name="estado" widget="badge" 
                       decoration-success="estado == 'disponible'" 
                       decoration-info="estado == 'asignado'" 
                       decoration-muted="estado == 'baja'"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Vista Kanban para Vehículos -->
    <record id="view_gestion_vehiculo_kanban" model="ir.ui.view">
        <field name="name">gestion.vehiculo.kanban</field>
        <field name="model">gestion.vehiculo</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado" records_draggable="false">
                <field name="id"/>
                <field name="matricula"/>
                <field name="marca_id"/>
                <field name="modelo"/>
                <field name="conductor_id"/>
                <field name="estado"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="matricula"/>
                                </strong>
                                <div>
                                    <span class="o_kanban_record_subtitle">
                                        <field name="marca_id"/> - <field name="modelo"/>
                                    </span>
                                </div>
                                <div t-if="record.conductor_id.value">
                                    <span class="text-muted">Conductor: </span>
                                    <field name="conductor_id"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="estado" widget="label_selection" 
                                        options="{'classes': {'disponible': 'success', 'asignado': 'info', 'baja': 'default'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista de búsqueda para Vehículos -->
    <record id="view_gestion_vehiculo_search" model="ir.ui.view">
        <field name="name">gestion.vehiculo.search</field>
        <field name="model">gestion.vehiculo</field>
        <field name="arch" type="xml">
            <search>
                <field name="matricula"/>
                <field name="modelo"/>
                <field name="marca_id"/>
                <field name="conductor_id"/>
                <separator/>
                <filter string="Disponibles" name="disponible" domain="[('estado', '=', 'disponible')]"/>
                <filter string="Asignados" name="asignado" domain="[('estado', '=', 'asignado')]"/>
                <separator/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Marca" name="group_by_marca" context="{'group_by': 'marca_id'}"/>
                <filter string="Estado" name="group_by_estado" context="{'group_by': 'estado'}"/>
            </search>
        </field>
    </record>

    <!-- Acción para Vehículos -->
    <record id="action_gestion_vehiculos" model="ir.actions.act_window">
        <field name="name">Vehículos</field>
        <field name="res_model">gestion.vehiculo</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_gestion_vehiculo_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer vehículo de tu flota.
            </p>
        </field>
    </record>
</odoo>